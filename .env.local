# Email notifications for new contact-form inquiries (SMTP). Leave SMTP_PASS empty to disable.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=thinktechsoftbd@gmail.com
SMTP_PASS=
# Optional: who receives inquiry emails (comma-separated). Defaults to site.contact.email.
INQUIRY_NOTIFY_TO=
