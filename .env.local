# Local secrets — not committed (see .gitignore).
DATABASE_URL=postgres://postgres:123@201.18.210.247:5432/thinktecherp
# Set to "true" if the database server requires TLS.
DATABASE_SSL=false
# Public URL of the site (used for sitemap, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for POST /api/revalidate (lets the ERP refresh cached pages after edits).
REVALIDATE_SECRET=ffe637c57bcb9569a4a23c33cebca1e8a5233eac06ec3e60

# Email notifications for new contact-form inquiries, sent through Resend (https://resend.com).
# Without a verified domain, Resend only delivers to the address the account was created with
# (thinktechsoftbd@gmail.com). To use Gmail instead, see .env.example.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend

MAIL_FROM=ThinkTech Website <onboarding@resend.dev>
# Optional: who receives inquiry emails (comma-separated). Defaults to site.contact.email.
INQUIRY_NOTIFY_TO=

