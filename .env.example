# Copy to .env.local and fill in.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/thinktecherp
# Set to "true" if the database server requires TLS.
DATABASE_SSL=false
# Schema that holds the website tables (services, posts, inquiries, ...). Default: public.
DATABASE_SCHEMA=public
# Public URL of the site (used for sitemap, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Shared secret for POST /api/revalidate (lets the ERP refresh cached pages after edits).
REVALIDATE_SECRET=change-me

# Email notifications for new contact-form inquiries (SMTP). Leave SMTP_PASS empty to disable.
# Resend (https://resend.com): SMTP_USER=resend and SMTP_PASS=<API key starting with re_>.
#   Without a verified domain, Resend only delivers to the address the account was created with.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<gmail address>, SMTP_PASS=<App Password from
#   https://myaccount.google.com/apppasswords> (needs 2-Step Verification; not your normal password).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Sender shown in the email. Required for Resend; defaults to "ThinkTech Website <SMTP_USER>".
MAIL_FROM=ThinkTech Website <onboarding@resend.dev>
# Optional: who receives inquiry emails (comma-separated). Defaults to site.contact.email.
INQUIRY_NOTIFY_TO=

# ThinkTech ERP API, called server-side for the subscription software on /pricing.
# The client is configured in the API under Authentication:Integration:Clients with the
# SHA-256 of ERP_CLIENT_SECRET and the "thinktech-website.exchange" scope.
# Without these the /pricing page simply leaves that section out.
ERP_API_URL=http://localhost:5291
ERP_CLIENT_ID=think_tech_official_site
ERP_CLIENT_SECRET=
