# Copy to .env.local and fill in.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/thinktecherp
# Set to "true" if the database server requires TLS.
DATABASE_SSL=false
# Public URL of the site (used for sitemap, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Shared secret for POST /api/revalidate (lets the ERP refresh cached pages after edits).
REVALIDATE_SECRET=change-me

# Email notifications for new contact-form inquiries (SMTP). Leave SMTP_PASS empty to disable.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional: who receives inquiry emails (comma-separated). Defaults to site.contact.email.
INQUIRY_NOTIFY_TO=
# Optional: sender name/address. Defaults to "ThinkTech Website <SMTP_USER>".
MAIL_FROM=
